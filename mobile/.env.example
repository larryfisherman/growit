# Copy to `.env` (dev) and `.env.production` (prod build) and fill in.
# All EXPO_PUBLIC_* vars are bundled into the app - they are identifiers, not secrets,
# but we keep the actual files out of git anyway. See scripts: `dev` (local API) / `dev:prod`.

# Leave empty in dev `.env` so the app targets the local backend (localhost:5053 / LAN IP).
# Set to the CloudFront URL in `.env.production`.
EXPO_PUBLIC_API_URL=

EXPO_PUBLIC_COGNITO_USER_POOL_ID=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
EXPO_PUBLIC_COGNITO_REGION=eu-central-1
